<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_waller_transaction_income" model="ir.sequence">
        <field name="name">Wallet Transaction Income</field>
        <field name="code">wallet.transaction</field>
        <field name="prefix">TXN-IN-%(year)s-</field>
        <field name="padding">7</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_waller_transaction_expense" model="ir.sequence">
        <field name="name">Wallet Transaction Expense</field>
        <field name="code">wallet.transaction</field>
        <field name="prefix">TXN-EXP-%(year)s-</field>
        <field name="padding">7</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
