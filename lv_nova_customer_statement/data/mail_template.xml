<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_customer_statement" model="mail.template">
            <field name="name">Customer Account Statement</field>
            <field name="model_id" ref="model_customer_statement_wizard"/>
            <field name="subject">Account Statement — {{ object.partner_id.name }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>Please find attached your account statement.</p>
                    <t t-if="object.date_from">
                        <p>
                            Period covered:
                            <strong><t t-out="object.date_from"/></strong>
                            to
                            <strong><t t-out="object.date_to"/></strong>.
                        </p>
                    </t>
                    <t t-else="">
                        <p>Statement as of <strong><t t-out="object.date_to"/></strong>.</p>
                    </t>
                    <p>
                        If you have any questions about your account,
                        please do not hesitate to contact us.
                    </p>
                    <p>
                        Best regards,<br/>
                        <strong><t t-out="object.company_id.name"/></strong>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
