<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Inherit the standard Delivery Slip to add the signature block
         at the bottom of the document.
         ================================================================ -->
    <template id="report_deliveryslip_signature"
              inherit_id="stock.report_deliveryslip">

        <xpath expr="//div[@class='page']" position="inside">
            <t t-if="o.delivery_signature">

                <div style="margin-top: 24px; border-top: 1px solid #ccc; padding-top: 12px;">
                    <div class="row">
                        <div class="col-6">
                            <p style="font-size:11px; color:#666; margin-bottom:4px;">
                                <strong>Delivery Signature</strong>
                                <t t-if="o.signed_by">
                                    — <t t-esc="o.signed_by"/>
                                </t>
                                <t t-if="o.signature_date">
                                    &#160;(<t t-esc="str(o.signature_date)[:16]"/>)
                                </t>
                            </p>
                            <img t-att-src="o._get_signature_b64()"
                                 style="max-width:240px; max-height:100px;
                                        border:1px solid #ddd; border-radius:4px;
                                        padding:4px; background:#fff;"
                                 alt="Delivery Signature"/>
                        </div>
                        <div class="col-6 text-end">
                            <p style="font-size:11px; color:#666; margin-bottom:50px;">
                                Received by / Recipient signature:
                            </p>
                            <div style="border-bottom:1px solid #999;
                                        width:200px; margin-left:auto;"/>
                            <p style="font-size:10px; color:#999; margin-top:4px;">
                                Signature &amp; date
                            </p>
                        </div>
                    </div>
                </div>

            </t>
            <t t-else="">
                <!-- Blank signature line when no digital signature captured -->
                <div style="margin-top: 32px; border-top: 1px solid #ccc; padding-top: 12px;">
                    <div class="row">
                        <div class="col-6">
                            <p style="font-size:11px; color:#666; margin-bottom:50px;">
                                Delivered by:
                            </p>
                            <div style="border-bottom:1px solid #999; width:200px;"/>
                            <p style="font-size:10px; color:#999; margin-top:4px;">
                                Signature &amp; date
                            </p>
                        </div>
                        <div class="col-6 text-end">
                            <p style="font-size:11px; color:#666; margin-bottom:50px;">
                                Received by:
                            </p>
                            <div style="border-bottom:1px solid #999;
                                        width:200px; margin-left:auto;"/>
                            <p style="font-size:10px; color:#999; margin-top:4px;">
                                Signature &amp; date
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
