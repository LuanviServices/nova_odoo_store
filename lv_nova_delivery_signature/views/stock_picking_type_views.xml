<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_type_form_signature" model="ir.ui.view">
        <field name="name">stock.picking.type.form.signature</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <!-- Add signature requirement option in the misc settings area -->
            <xpath expr="//field[@name='show_operations']" position="after">
                <field name="signature_required"
                       widget="boolean_toggle"
                       string="Require signature before validation"/>
            </xpath>
        </field>
    </record>

</odoo>
