<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_term_form_early_discount" model="ir.ui.view">
        <field name="name">account.payment.term.form.early.discount</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <separator string="Early Payment Discount"/>
                <group>
                    <group>
                        <field name="early_discount"/>
                        <field name="early_discount_pct"
                               invisible="not early_discount"
                               required="early_discount"/>
                        <field name="early_discount_days"
                               invisible="not early_discount"
                               required="early_discount"/>
                    </group>
                    <group>
                        <field name="early_discount_account_id"
                               invisible="not early_discount"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <p class="text-muted" style="font-size:12px; padding: 0 8px 8px;"
                   invisible="not early_discount">
                    Example: "2/10 net 30" means 2% discount if paid within 10 days,
                    full amount due in 30 days. The discount reduces the untaxed amount.
                </p>
            </xpath>
        </field>
    </record>

</odoo>
