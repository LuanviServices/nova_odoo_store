<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_finiquito" model="ir.ui.view">
        <field name="name">hr.employee.form.finiquito</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="action"
                        name="%(lv_nova_hr_finiquito.action_hr_finiquito)d"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        context="{'search_default_employee_id': active_id,
                                  'default_employee_id': active_id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Finiquito</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
