<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_overtime" model="ir.ui.view">
        <field name="name">hr.employee.form.overtime</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_overtime_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        invisible="overtime_line_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="overtime_bank_balance"
                                   widget="float_time"/>
                        </span>
                        <span class="o_stat_text">Time Bank</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
