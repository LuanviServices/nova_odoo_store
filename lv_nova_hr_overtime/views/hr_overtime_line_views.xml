<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_hr_overtime_line_list" model="ir.ui.view">
        <field name="name">hr.overtime.line.list</field>
        <field name="model">hr.overtime.line</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'"
                  decoration-warning="state == 'draft'"
                  decoration-info="state == 'approved'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="move_type"/>
                <field name="hours" string="Hours"/>
                <field name="compensation_type"
                       invisible="move_type != 'overtime'"/>
                <field name="rate"
                       invisible="compensation_type != 'pay' or move_type != 'overtime'"
                       optional="hide"/>
                <field name="payable_hours"
                       invisible="compensation_type != 'pay' or move_type != 'overtime'"
                       optional="hide"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'approved'"
                       decoration-success="state == 'paid'"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_hr_overtime_line_form" model="ir.ui.view">
        <field name="name">hr.overtime.line.form</field>
        <field name="model">hr.overtime.line</field>
        <field name="arch" type="xml">
            <form string="Overtime / Time Bank Line">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="hr.group_hr_user"/>
                    <button name="action_mark_paid" type="object"
                            string="Mark Paid / Compensated"
                            class="btn-secondary"
                            invisible="state != 'approved'"
                            groups="hr.group_hr_user"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state == 'draft'"
                            groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee &amp; Date">
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="attendance_id" optional="1"/>
                        </group>
                        <group string="Details">
                            <field name="move_type"/>
                            <field name="hours"/>
                            <field name="compensation_type"
                                   invisible="move_type != 'overtime'"/>
                            <field name="rate"
                                   invisible="compensation_type != 'pay' or move_type != 'overtime'"/>
                            <field name="payable_hours"
                                   invisible="compensation_type != 'pay' or move_type != 'overtime'"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Optional remark…"/>
                        <field name="approved_by" readonly="1"
                               invisible="not approved_by"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────── -->
    <record id="view_hr_overtime_line_search" model="ir.ui.view">
        <field name="name">hr.overtime.line.search</field>
        <field name="model">hr.overtime.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="To Approve" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state','=','approved')]"/>
                <filter string="Paid / Compensated" name="paid"
                        domain="[('state','=','paid')]"/>
                <separator/>
                <filter string="Overtime Earned" name="overtime"
                        domain="[('move_type','=','overtime')]"/>
                <filter string="Time Off Taken" name="compensation"
                        domain="[('move_type','=','compensation')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                  ('date','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="by_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Month" name="by_month"
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Status" name="by_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────────────────── -->
    <record id="action_hr_overtime_line_all" model="ir.actions.act_window">
        <field name="name">Overtime &amp; Time Bank</field>
        <field name="res_model">hr.overtime.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                No overtime lines yet. Use "Compute Overtime" to detect
                them automatically from attendance records.
            </p>
        </field>
    </record>

    <record id="action_hr_overtime_wizard_open" model="ir.actions.act_window">
        <field name="name">Compute Overtime</field>
        <field name="res_model">hr.overtime.compute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── Menus ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_hr_overtime_root"
              name="Overtime"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="20"/>

    <menuitem id="menu_hr_overtime_lines"
              name="Overtime &amp; Time Bank"
              parent="menu_hr_overtime_root"
              action="action_hr_overtime_line_all"
              sequence="10"/>

    <menuitem id="menu_hr_overtime_compute"
              name="Compute Overtime"
              parent="menu_hr_overtime_root"
              action="action_hr_overtime_wizard_open"
              sequence="20"
              groups="hr.group_hr_user"/>

</odoo>
