<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Invoice / Bill form — add Lots/Expiry column after product
         ================================================================ -->
    <record id="view_move_form_expiry" model="ir.ui.view">
        <field name="name">account.move.form.expiry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add lot expiry column in invoice lines list -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']"
                   position="after">
                <field name="lot_expiry_display"
                       string="Lots / Expiry"
                       optional="show"
                       readonly="1"/>
                <field name="lot_expiry_state"
                       string="Expiry Status"
                       optional="show"
                       widget="badge"
                       decoration-danger="lot_expiry_state == 'expired'"
                       decoration-warning="lot_expiry_state == 'warning'"
                       decoration-success="lot_expiry_state == 'ok'"
                       readonly="1"
                       invisible="lot_expiry_state == 'none'"/>
            </xpath>

        </field>
    </record>

</odoo>
