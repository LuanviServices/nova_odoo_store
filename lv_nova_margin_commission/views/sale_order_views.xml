<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_margin_commission" model="ir.ui.view">
        <field name="name">sale.order.form.margin.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Scale selector next to salesperson -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="margin_commission_scale_id"
                       groups="sales_team.group_sale_manager"/>
            </xpath>

            <!-- Print commission report button -->
            <xpath expr="//header" position="inside">
                <button name="action_print_commission_report"
                        type="object"
                        string="🖨 Commission Report"
                        class="btn-secondary"
                        invisible="not margin_commission_scale_id"
                        groups="sales_team.group_sale_manager"/>
            </xpath>

            <!-- Optional columns on order lines: margin %, commission -->
            <xpath expr="//field[@name='order_line']//field[@name='price_subtotal']"
                   position="before">
                <field name="line_margin_pct"
                       string="Margin %"
                       optional="hide"
                       widget="percentage"
                       decoration-danger="line_margin_pct &lt; 0"
                       decoration-warning="line_margin_pct &gt;= 0 and line_margin_pct &lt; 15"
                       decoration-success="line_margin_pct &gt;= 15"/>
                <field name="commission_rate"
                       string="Comm. %"
                       optional="hide"/>
                <field name="commission_amount"
                       string="Commission"
                       optional="show"
                       widget="monetary"
                       groups="sales_team.group_sale_manager"/>
            </xpath>

            <!-- Summary section as its own notebook page (safer anchor) -->
            <xpath expr="//notebook" position="inside">
                <page string="Margin &amp; Commission"
                      name="margin_commission"
                      invisible="not margin_commission_scale_id"
                      groups="sales_team.group_sale_manager">
                    <group>
                        <group string="Totals">
                            <field name="total_margin" widget="monetary"/>
                            <field name="total_margin_pct" widget="percentage"/>
                            <field name="total_commission" widget="monetary"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
