<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_tip_report_wizard_form" model="ir.ui.view">
        <field name="name">pos.tip.report.wizard.form</field>
        <field name="model">pos.tip.report.wizard</field>
        <field name="arch" type="xml">
            <form string="POS Tip Report">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filters">
                        <field name="config_id"
                               options="{'no_create': True}"
                               placeholder="All POS"/>
                        <field name="only_with_tips"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf"
                            type="object"
                            string="🖨 Print PDF Report"
                            class="btn-primary"/>
                    <button name="action_view_orders"
                            type="object"
                            string="View Orders"
                            class="btn-secondary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
