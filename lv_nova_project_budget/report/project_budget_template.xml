<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_project_budget_document">
        <t t-call="web.external_layout">
            <div class="page">

                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-7">
                        <h3 class="mb-1">Project Budget Report</h3>
                        <p class="fw-bold mb-0" t-esc="doc.name"/>
                        <p class="text-muted mb-0" t-if="doc.partner_id">
                            Customer: <t t-esc="doc.partner_id.name"/>
                        </p>
                    </div>
                    <div class="col-5 text-end">
                        <p class="mb-0">
                            <strong>Date: </strong>
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                        </p>
                        <p class="mb-0" t-if="doc.user_ids">
                            <strong>Manager: </strong>
                            <t t-esc="', '.join(doc.user_ids.mapped('name'))"/>
                        </p>
                        <!-- Alert badge -->
                        <t t-set="alv" t-value="doc.budget_alert_level"/>
                        <span t-attf-style="
                            display:inline-block; margin-top:4px;
                            padding:3px 10px; border-radius:12px; font-size:11px;
                            font-weight:bold;
                            background:#{alv == 'exceeded' and '#fee2e2' or alv == 'warning' and '#fef9c3' or '#dcfce7'};
                            color:#{alv == 'exceeded' and '#dc2626' or alv == 'warning' and '#854d0e' or '#166534'}">
                            <t t-esc="dict(doc.fields_get(['budget_alert_level'])['budget_alert_level']['selection']).get(alv, alv)"/>
                        </span>
                    </div>
                </div>

                <!-- KPI summary -->
                <table class="table table-bordered text-center mb-4"
                       style="font-size:13px;">
                    <thead class="table-dark">
                        <tr>
                            <th>Metric</th>
                            <th>Budget</th>
                            <th>Spent</th>
                            <th>Remaining</th>
                            <th>% Used</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="doc.budget_hours">
                            <tr>
                                <td><strong>Hours</strong></td>
                                <td t-esc="'%.2f h' % doc.budget_hours"/>
                                <td t-attf-style="color:#{doc.hours_pct >= 100 and '#dc3545' or doc.hours_pct >= 80 and '#856404' or 'inherit'}">
                                    <t t-esc="'%.2f h' % doc.spent_hours"/>
                                </td>
                                <td t-esc="'%.2f h' % doc.remaining_hours"/>
                                <td>
                                    <t t-set="hp" t-value="doc.hours_pct"/>
                                    <span t-attf-style="font-weight:bold; color:#{hp >= 100 and '#dc3545' or hp >= 80 and '#856404' or '#198754'}">
                                        <t t-esc="'%.1f %%' % hp"/>
                                    </span>
                                    <!-- Progress bar -->
                                    <div style="background:#e9ecef;border-radius:4px;height:8px;margin-top:4px;">
                                        <div t-attf-style="width:#{min(hp,100)}%;height:8px;border-radius:4px;background:#{hp >= 100 and '#dc3545' or hp >= 80 and '#ffc107' or '#198754'};"/>
                                    </div>
                                </td>
                            </tr>
                        </t>
                        <t t-if="doc.budget_amount">
                            <tr>
                                <td><strong>Amount</strong></td>
                                <td t-esc="doc._fmt(doc.budget_amount)"/>
                                <td t-attf-style="color:#{doc.amount_pct >= 100 and '#dc3545' or doc.amount_pct >= 80 and '#856404' or 'inherit'}">
                                    <t t-esc="doc._fmt(doc.spent_amount)"/>
                                </td>
                                <td t-esc="doc._fmt(doc.remaining_amount)"/>
                                <td>
                                    <t t-set="ap" t-value="doc.amount_pct"/>
                                    <span t-attf-style="font-weight:bold; color:#{ap >= 100 and '#dc3545' or ap >= 80 and '#856404' or '#198754'}">
                                        <t t-esc="'%.1f %%' % ap"/>
                                    </span>
                                    <div style="background:#e9ecef;border-radius:4px;height:8px;margin-top:4px;">
                                        <div t-attf-style="width:#{min(ap,100)}%;height:8px;border-radius:4px;background:#{ap >= 100 and '#dc3545' or ap >= 80 and '#ffc107' or '#198754'};"/>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Timesheet breakdown -->
                <t t-set="ts_lines" t-value="doc.timesheet_ids.sorted('date')"/>
                <t t-if="ts_lines">
                    <h5 class="mt-3">Timesheet Log</h5>
                    <table class="table table-sm table-hover table-bordered"
                           style="font-size:11px;">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Employee</th>
                                <th>Task</th>
                                <th>Description</th>
                                <th class="text-end">Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="ts_lines" t-as="ts">
                                <tr>
                                    <td t-esc="ts.date"/>
                                    <td t-esc="ts.employee_id.name or ''"/>
                                    <td t-esc="ts.task_id.name if ts.task_id else ''"/>
                                    <td t-esc="ts.name or ''"/>
                                    <td class="text-end" t-esc="'%.2f' % ts.unit_amount"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4">Total Hours</td>
                                <td class="text-end" t-esc="'%.2f h' % doc.spent_hours"/>
                            </tr>
                        </tfoot>
                    </table>
                </t>

            </div>
        </t>
    </template>

    <template id="report_project_budget">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="lv_nova_project_budget.report_project_budget_document"/>
            </t>
        </t>
    </template>

</odoo>
