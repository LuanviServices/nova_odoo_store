<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         1. Project form — budget tab + alert banners + smart button
         ================================================================ -->
    <record id="view_project_form_budget" model="ir.ui.view">
        <field name="name">project.project.form.budget</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- Smart button -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_print_budget_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bar-chart"
                        invisible="not has_budget">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="hours_pct"
                                   widget="float"
                                   digits="[4,0]"/>%
                        </span>
                        <span class="o_stat_text">Budget Used</span>
                    </div>
                </button>
            </xpath>

            <!-- Alert banners above the sheet content -->
            <xpath expr="//sheet" position="inside">
                <!-- Hidden computed fields -->
                <field name="budget_alert_level"  invisible="1"/>
                <field name="hours_pct"           invisible="1"/>
                <field name="amount_pct"          invisible="1"/>

                <!-- Exceeded (>100%) -->
                <div class="alert alert-danger mb-3"
                     invisible="not has_budget or budget_alert_level != 'exceeded'">
                    <strong>🚨 Budget Exceeded!</strong>
                    <t t-if="budget_hours">
                        Hours: <field name="spent_hours" readonly="1"/>
                        / <field name="budget_hours" readonly="1"/> h
                        (<field name="hours_pct" readonly="1"/>%).
                    </t>
                    <t t-if="budget_amount">
                        Spend: <field name="spent_amount" widget="monetary" readonly="1"/>
                        / <field name="budget_amount" widget="monetary" readonly="1"/>
                        (<field name="amount_pct" readonly="1"/>%).
                    </t>
                </div>

                <!-- Warning (80–100%) -->
                <div class="alert alert-warning mb-3"
                     invisible="not has_budget or budget_alert_level != 'warning'">
                    <strong>⚠ Budget Warning (over 80%)</strong> —
                    <t t-if="budget_hours">
                        <field name="spent_hours" readonly="1"/> /
                        <field name="budget_hours" readonly="1"/> h
                        (<field name="hours_pct" readonly="1"/>%).
                    </t>
                    <t t-if="budget_amount">
                        <field name="spent_amount" widget="monetary" readonly="1"/> /
                        <field name="budget_amount" widget="monetary" readonly="1"/>
                        (<field name="amount_pct" readonly="1"/>%).
                    </t>
                </div>
            </xpath>

            <!-- Budget tab inside the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Budget" name="budget">
                    <group>
                        <field name="has_budget"/>
                    </group>
                    <group invisible="not has_budget">
                        <group string="Hour Budget">
                            <field name="budget_hours"
                                   invisible="not has_budget"/>
                            <field name="spent_hours"   readonly="1"
                                   invisible="not has_budget"/>
                            <field name="remaining_hours" readonly="1"
                                   invisible="not has_budget"/>
                            <field name="hours_pct"
                                   string="% Used"
                                   readonly="1"
                                   invisible="not has_budget or not budget_hours"/>
                        </group>
                        <group string="Monetary Budget">
                            <field name="budget_amount"
                                   widget="monetary"
                                   invisible="not has_budget"/>
                            <field name="spent_amount"
                                   widget="monetary"
                                   readonly="1"
                                   invisible="not has_budget"/>
                            <field name="remaining_amount"
                                   widget="monetary"
                                   readonly="1"
                                   invisible="not has_budget"/>
                            <field name="amount_pct"
                                   string="% Used"
                                   readonly="1"
                                   invisible="not has_budget or not budget_amount"/>
                        </group>
                    </group>
                    <group string="Alert Status" invisible="not has_budget">
                        <field name="budget_alert_level"
                               widget="badge"
                               decoration-danger="budget_alert_level == 'exceeded'"
                               decoration-warning="budget_alert_level == 'warning'"
                               decoration-success="budget_alert_level == 'ok'"
                               readonly="1"/>
                        <field name="alert_80_sent"  readonly="1" optional="1"/>
                        <field name="alert_100_sent" readonly="1" optional="1"/>
                    </group>
                    <field name="currency_id" invisible="1"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ================================================================
         2. Budget overview list — all projects with budget metrics
         ================================================================ -->
    <record id="view_project_budget_list" model="ir.ui.view">
        <field name="name">project.project.budget.list</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list decoration-danger="budget_alert_level == 'exceeded'"
                  decoration-warning="budget_alert_level == 'warning'">
                <field name="name" string="Project"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="budget_alert_level"
                       widget="badge"
                       decoration-danger="budget_alert_level == 'exceeded'"
                       decoration-warning="budget_alert_level == 'warning'"
                       decoration-success="budget_alert_level == 'ok'"
                       string="Status"/>
                <!-- Hours -->
                <field name="budget_hours"   string="Hrs Budget" optional="show"/>
                <field name="spent_hours"    string="Hrs Spent"/>
                <field name="remaining_hours" string="Hrs Left" optional="show"/>
                <field name="hours_pct"      string="Hrs %" widget="percentage"/>
                <!-- Money -->
                <field name="budget_amount"   string="$ Budget"  widget="monetary" optional="show"/>
                <field name="spent_amount"    string="$ Spent"   widget="monetary" optional="show"/>
                <field name="remaining_amount" string="$ Left"   widget="monetary" optional="show"/>
                <field name="amount_pct"      string="$ %"       widget="percentage" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_print_budget_report"
                        type="object"
                        icon="fa-print"
                        string="Print"
                        title="Print budget report"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         3. Search
         ================================================================ -->
    <record id="view_project_budget_search" model="ir.ui.view">
        <field name="name">project.project.budget.search</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Budget Enabled" name="has_budget"
                        domain="[('has_budget','=',True)]"/>
                <filter string="Exceeded" name="exceeded"
                        domain="[('budget_alert_level','=','exceeded')]"/>
                <filter string="Warning (&gt;80%)" name="warning"
                        domain="[('budget_alert_level','=','warning')]"/>
                <filter string="On Track" name="ok"
                        domain="[('budget_alert_level','=','ok')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="by_status"
                            context="{'group_by':'budget_alert_level'}"/>
                    <filter string="Customer" name="by_customer"
                            context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         4. Action + menu
         ================================================================ -->
    <record id="action_project_budget" model="ir.actions.act_window">
        <field name="name">Project Budgets</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="views">[
            (%(view_project_budget_list)d, 'list'),
            (False, 'form')
        ]</field>
        <field name="domain">[('has_budget','=',True)]</field>
        <field name="context">{'search_default_has_budget': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                No projects have budgets enabled yet.
                Open a project, go to the Budget tab,
                enable "Enable Budget" and set your limits.
            </p>
        </field>
    </record>

    <menuitem id="menu_project_budget"
              name="Budgets"
              parent="project.menu_projects"
              action="action_project_budget"
              sequence="25"
              groups="project.group_project_manager"/>

</odoo>
