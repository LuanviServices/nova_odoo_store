<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_project_profitability_document">
        <t t-call="web.external_layout">
            <t t-set="data" t-value="doc._get_profitability_data()"/>
            <t t-set="currency" t-value="doc.company_id.currency_id"/>

            <div class="page">

                <!-- ── Header ─────────────────────────────────────────── -->
                <div class="row mb-4">
                    <div class="col-7">
                        <h3 class="mb-1">Project Profitability Report</h3>
                        <p class="mb-0 fw-bold" t-esc="doc.name"/>
                        <p class="text-muted mb-0" t-if="doc.partner_id">
                            Customer: <t t-esc="doc.partner_id.name"/>
                        </p>
                        <p class="text-muted mb-0" t-if="doc.analytic_account_id">
                            Analytic account: <t t-esc="doc.analytic_account_id.name"/>
                        </p>
                    </div>
                    <div class="col-5 text-end">
                        <p class="mb-0">
                            <strong>Printed: </strong>
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                        </p>
                        <p class="mb-0" t-if="doc.user_ids">
                            <strong>Manager: </strong>
                            <t t-esc="', '.join(doc.user_ids.mapped('name'))"/>
                        </p>
                    </div>
                </div>

                <!-- ── KPI summary strip ──────────────────────────────── -->
                <t t-set="total_cost" t-value="data['cost_timesheet'] + data['cost_purchase']"/>
                <t t-set="margin_val" t-value="data['revenue_invoiced'] - total_cost"/>
                <t t-set="margin_pct" t-value="(margin_val / data['revenue_invoiced'] * 100.0) if data['revenue_invoiced'] else 0.0"/>

                <table class="table table-bordered text-center mb-4"
                       style="font-size:13px;">
                    <thead class="table-dark">
                        <tr>
                            <th>Invoiced Revenue</th>
                            <th>Timesheet Cost</th>
                            <th>Purchase Cost</th>
                            <th>Total Cost</th>
                            <th>Gross Margin</th>
                            <th>Margin %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="font-weight:700; font-size:14px;">
                            <td t-esc="doc._fmt(data['revenue_invoiced'])"/>
                            <td style="color:#dc3545;"
                                t-esc="doc._fmt(data['cost_timesheet'])"/>
                            <td style="color:#dc3545;"
                                t-esc="doc._fmt(data['cost_purchase'])"/>
                            <td style="color:#dc3545; font-weight:700;"
                                t-esc="doc._fmt(total_cost)"/>
                            <td t-attf-style="color:#{margin_val >= 0 and '#198754' or '#dc3545'};font-weight:700;"
                                t-esc="doc._fmt(margin_val)"/>
                            <td t-attf-style="color:#{margin_pct >= 0 and '#198754' or '#dc3545'};font-weight:700;"
                                t-esc="'%.1f %%' % margin_pct"/>
                        </tr>
                    </tbody>
                </table>

                <!-- ── Revenue detail ────────────────────────────────── -->
                <t t-if="data['invoice_lines']">
                    <h5 class="mt-3">Invoiced Revenue Detail</h5>
                    <table class="table table-sm table-hover table-bordered"
                           style="font-size:11px;">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Product / Description</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Analytic %</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['invoice_lines']" t-as="ln">
                                <tr>
                                    <td t-esc="ln['date']"/>
                                    <td t-esc="ln['ref']"/>
                                    <td t-esc="ln['partner']"/>
                                    <td t-esc="ln['product']"/>
                                    <td class="text-end" t-esc="'%.2f' % ln['qty']"/>
                                    <td class="text-end" t-esc="doc._fmt(ln['price'])"/>
                                    <td class="text-end" t-esc="'%.0f %%' % ln['pct']"/>
                                    <td class="text-end fw-bold"
                                        t-esc="doc._fmt(ln['subtotal'])"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="7">Total Invoiced</td>
                                <td class="text-end"
                                    t-esc="doc._fmt(data['revenue_invoiced'])"/>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <!-- ── Timesheet cost detail ──────────────────────────── -->
                <t t-if="data['timesheet_lines']">
                    <h5 class="mt-4">Timesheet Cost Detail</h5>
                    <table class="table table-sm table-hover table-bordered"
                           style="font-size:11px;">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Employee</th>
                                <th>Task</th>
                                <th>Description</th>
                                <th class="text-end">Hours</th>
                                <th class="text-end">Rate/h</th>
                                <th class="text-end">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['timesheet_lines']" t-as="ts">
                                <tr>
                                    <td t-esc="ts['date']"/>
                                    <td t-esc="ts['employee']"/>
                                    <td t-esc="ts['task']"/>
                                    <td t-esc="ts['desc']"/>
                                    <td class="text-end" t-esc="'%.2f' % ts['hours']"/>
                                    <td class="text-end" t-esc="doc._fmt(ts['rate'])"/>
                                    <td class="text-end" t-esc="doc._fmt(ts['cost'])"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4">Total</td>
                                <td class="text-end"
                                    t-esc="'%.2f h' % data['timesheet_hours']"/>
                                <td/>
                                <td class="text-end" style="color:#dc3545;"
                                    t-esc="doc._fmt(data['cost_timesheet'])"/>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <!-- ── Purchase cost detail ───────────────────────────── -->
                <t t-if="data['purchase_lines']">
                    <h5 class="mt-4">Purchase / Expense Cost Detail</h5>
                    <table class="table table-sm table-hover table-bordered"
                           style="font-size:11px;">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Bill / Ref</th>
                                <th>Vendor</th>
                                <th>Product / Description</th>
                                <th class="text-end">Analytic %</th>
                                <th class="text-end">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['purchase_lines']" t-as="ln">
                                <tr>
                                    <td t-esc="ln['date']"/>
                                    <td t-esc="ln['ref']"/>
                                    <td t-esc="ln['partner']"/>
                                    <td t-esc="ln['product']"/>
                                    <td class="text-end" t-esc="'%.0f %%' % ln['pct']"/>
                                    <td class="text-end" t-esc="doc._fmt(ln['amount'])"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5">Total Purchases</td>
                                <td class="text-end" style="color:#dc3545;"
                                    t-esc="doc._fmt(data['cost_purchase'])"/>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <!-- ── Empty state ───────────────────────────────────── -->
                <t t-if="not data['invoice_lines'] and not data['timesheet_lines'] and not data['purchase_lines']">
                    <div class="alert alert-info mt-4">
                        No invoiced revenue, timesheet entries, or vendor bills
                        linked to this project's analytic account yet.
                    </div>
                </t>

            </div>
        </t>
    </template>

    <template id="report_project_profitability">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="lv_nova_project_profitability.report_project_profitability_document"/>
            </t>
        </t>
    </template>

</odoo>
