<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         1. Profitability list — all projects at a glance
         ================================================================ -->
    <record id="view_project_profitability_list" model="ir.ui.view">
        <field name="name">project.project.profitability.list</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list decoration-danger="margin_percent &lt; 0"
                  decoration-warning="margin_percent &gt;= 0 and margin_percent &lt; 15"
                  decoration-success="margin_percent &gt;= 15"
                  default_order="margin_percent asc">
                <field name="name" string="Project"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="user_ids" string="Manager" optional="show"/>
                <field name="timesheet_hours" string="Hours" optional="show"/>
                <field name="revenue_invoiced" widget="monetary" sum="Total"/>
                <field name="cost_timesheet"   widget="monetary" sum="Total" optional="show"/>
                <field name="cost_purchase"    widget="monetary" sum="Total" optional="show"/>
                <field name="cost_total"       widget="monetary" sum="Total"/>
                <field name="margin"           widget="monetary" sum="Total"/>
                <field name="margin_percent"   string="Margin %" widget="percentage"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         2. Profitability detail form — KPI cards + breakdown tables
         ================================================================ -->
    <record id="view_project_profitability_form" model="ir.ui.view">
        <field name="name">project.project.profitability.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="Project Profitability" create="false" edit="false">
                <header>
                    <button name="action_print_profitability"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <!-- Project name + period -->
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="analytic_account_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_tags" readonly="1"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date" string="End Date" readonly="1"/>
                        </group>
                    </group>

                    <!-- KPI strip -->
                    <div class="row mt-3 mb-3">
                        <div class="col-md-2">
                            <div class="card text-center border-0 bg-light">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Invoiced</div>
                                    <h5 class="mb-0">
                                        <field name="revenue_invoiced" widget="monetary" readonly="1"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card text-center border-0 bg-light">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Timesheet Cost</div>
                                    <h5 class="mb-0 text-danger">
                                        <field name="cost_timesheet" widget="monetary" readonly="1"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card text-center border-0 bg-light">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Purchase Cost</div>
                                    <h5 class="mb-0 text-danger">
                                        <field name="cost_purchase" widget="monetary" readonly="1"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card text-center border-0 bg-light">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Total Cost</div>
                                    <h5 class="mb-0 text-danger">
                                        <field name="cost_total" widget="monetary" readonly="1"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card text-center border-0 bg-light">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Gross Margin</div>
                                    <h5 class="mb-0">
                                        <field name="margin" widget="monetary" readonly="1"
                                               class="text-success"
                                               invisible="margin &lt; 0"/>
                                        <field name="margin" widget="monetary" readonly="1"
                                               class="text-danger"
                                               invisible="margin &gt;= 0"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card text-center border-0 bg-light">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Margin %</div>
                                    <h5 class="mb-0">
                                        <field name="margin_percent" widget="percentage" readonly="1"
                                               class="text-success"
                                               invisible="margin_percent &lt; 0"/>
                                        <field name="margin_percent" widget="percentage" readonly="1"
                                               class="text-danger"
                                               invisible="margin_percent &gt;= 0"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <field name="currency_id" invisible="1"/>
                    <field name="timesheet_hours" invisible="1"/>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         3. Search view
         ================================================================ -->
    <record id="view_project_profitability_search" model="ir.ui.view">
        <field name="name">project.project.profitability.search</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Project"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_ids" string="Manager"/>
                <filter string="Negative Margin" name="negative"
                        domain="[('margin_percent','&lt;',0)]"/>
                <filter string="Low Margin (&lt;15%)" name="low_margin"
                        domain="[('margin_percent','&gt;=',0),('margin_percent','&lt;',15)]"/>
                <filter string="Healthy Margin (≥15%)" name="healthy"
                        domain="[('margin_percent','&gt;=',15)]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="by_customer"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Manager" name="by_manager"
                            context="{'group_by':'user_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         4. Action + Menu
         ================================================================ -->
    <record id="action_project_profitability" model="ir.actions.act_window">
        <field name="name">Project Profitability</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="views">[
            (%(view_project_profitability_list)d, 'list'),
            (%(view_project_profitability_form)d, 'form')
        ]</field>
        <field name="domain">[('active','in',[True,False])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                No projects found. Projects appear here once they have
                invoiced revenue or logged timesheets.
            </p>
        </field>
    </record>

    <menuitem id="menu_project_profitability"
              name="Profitability"
              parent="project.menu_projects"
              action="action_project_profitability"
              sequence="20"
              groups="project.group_project_manager"/>

</odoo>
