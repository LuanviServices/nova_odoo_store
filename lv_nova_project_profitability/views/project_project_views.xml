<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_profitability" model="ir.ui.view">
        <field name="name">project.project.form.profitability</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_profitability"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bar-chart">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="margin_percent" widget="percentage"/>
                        </span>
                        <span class="o_stat_text">Margin</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
