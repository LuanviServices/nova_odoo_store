<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_recurring_tasks" model="ir.cron">
            <field name="name">Recurring Tasks — Daily Generate &amp; Overdue</field>
            <field name="model_id" ref="model_recurring_task_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_instances()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
