<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_sale_approval_line_own" model="ir.rule">
            <field name="name">Approval line: salesperson sees only own order lines</field>
            <field name="model_id" ref="model_sale_approval_line"/>
            <field name="domain_force">[('order_id.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
    </data>
</odoo>
