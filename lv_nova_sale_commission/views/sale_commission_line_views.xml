<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_commission_line_list" model="ir.ui.view">
        <field name="name">sale.commission.line.list</field>
        <field name="model">sale.commission.line</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" multi_edit="0">
                <field name="date"/>
                <field name="salesperson_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="base_amount" widget="monetary"/>
                <field name="rate"/>
                <field name="commission_amount" widget="monetary" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'confirmed'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sale_commission_line_form" model="ir.ui.view">
        <field name="name">sale.commission.line.form</field>
        <field name="model">sale.commission.line</field>
        <field name="arch" type="xml">
            <form string="Commission Line">
                <header>
                    <button name="action_mark_paid" type="object"
                            string="Mark as Paid" class="btn-primary"
                            invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id"/>
                            <field name="invoice_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="plan_id"/>
                            <field name="base_amount"/>
                            <field name="rate"/>
                            <field name="commission_amount"/>
                            <field name="date"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_commission_line_search" model="ir.ui.view">
        <field name="name">sale.commission.line.search</field>
        <field name="model">sale.commission.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="salesperson_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="paid"
                        domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Salesperson" name="group_salesperson"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_commission_line" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">sale.commission.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Commission lines appear here once orders are confirmed or
                invoices are paid, depending on the plan's trigger.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_commission_root"
              name="Commissions"
              parent="sale.sale_menu_root"
              action="action_sale_commission_line"
              sequence="25"/>

</odoo>
