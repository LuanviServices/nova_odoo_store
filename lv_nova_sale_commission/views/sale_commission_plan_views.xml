<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_commission_plan_form" model="ir.ui.view">
        <field name="name">sale.commission.plan.form</field>
        <field name="model">sale.commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Standard Sales Commission"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="basis"/>
                            <field name="calc_method"/>
                            <field name="default_rate"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Category Rates" name="category_rates">
                            <p class="text-muted">
                                Override the default rate for specific
                                product categories. The most specific
                                category match wins; if none match, the
                                default rate above is used.
                            </p>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category_id"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_commission_plan_list" model="ir.ui.view">
        <field name="name">sale.commission.plan.list</field>
        <field name="model">sale.commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="basis"/>
                <field name="calc_method"/>
                <field name="default_rate"/>
            </list>
        </field>
    </record>

    <record id="action_sale_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">sale.commission.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first commission plan
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_commission_plan"
              name="Commission Plans"
              action="action_sale_commission_plan"
              parent="sale.menu_sale_config"
              sequence="50"/>

</odoo>
