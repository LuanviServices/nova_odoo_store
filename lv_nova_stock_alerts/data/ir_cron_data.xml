<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_stock_alerts" model="ir.cron">
            <field name="name">Stock Alerts — Daily Digest Email</field>
            <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_stock_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
