<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_stock_alerts_document">
        <t t-call="web.external_layout">
            <div class="page">

                <div class="row mb-4">
                    <div class="col-8">
                        <h3 class="mb-1">Stock Alert Report</h3>
                        <p class="text-muted mb-0">
                            Products below minimum stock level
                        </p>
                    </div>
                    <div class="col-4 text-end">
                        <p class="mb-0">
                            <strong>Date: </strong>
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                        </p>
                    </div>
                </div>

                <!-- KPI strip -->
                <t t-set="critical_docs" t-value="docs.filtered(lambda d: d.alert_level == 'critical')"/>
                <t t-set="warning_docs"  t-value="docs.filtered(lambda d: d.alert_level == 'warning')"/>
                <div class="row mb-4 text-center">
                    <div class="col-3">
                        <div class="border rounded p-2">
                            <div class="fw-bold" style="font-size:20px;">
                                <t t-esc="len(docs)"/>
                            </div>
                            <div class="text-muted small">Total Rules</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-2">
                            <div class="fw-bold" style="font-size:20px;color:#dc3545;">
                                <t t-esc="len(critical_docs)"/>
                            </div>
                            <div class="text-muted small">Out of Stock</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-2">
                            <div class="fw-bold" style="font-size:20px;color:#856404;">
                                <t t-esc="len(warning_docs)"/>
                            </div>
                            <div class="text-muted small">Low Stock</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-2">
                            <div class="fw-bold" style="font-size:20px;">
                                <t t-esc="len(docs.filtered(lambda d: d.supplier_id))"/>
                            </div>
                            <div class="text-muted small">With Supplier</div>
                        </div>
                    </div>
                </div>

                <table class="table table-sm table-bordered" style="font-size:12px;">
                    <thead class="table-light">
                        <tr>
                            <th>Level</th>
                            <th>Product</th>
                            <th>Location</th>
                            <th class="text-end">On Hand</th>
                            <th class="text-end">Min</th>
                            <th class="text-end">Max</th>
                            <th class="text-end">To Order</th>
                            <th>Supplier</th>
                            <th class="text-end">Lead (d)</th>
                            <th>ETA</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs.sorted(lambda d: (d.alert_level, d.product_id.name))" t-as="doc">
                            <tr t-attf-style="background:#{doc.alert_level == 'critical' and '#fff5f5' or doc.alert_level == 'warning' and '#fffbf0' or 'white'}">
                                <td>
                                    <span t-attf-style="color:#{doc.alert_level == 'critical' and '#dc3545' or doc.alert_level == 'warning' and '#856404' or '#198754'};font-weight:600;">
                                        <t t-esc="doc.alert_level.upper()"/>
                                    </span>
                                </td>
                                <td t-esc="doc.product_id.display_name"/>
                                <td t-esc="doc.location_id.complete_name"/>
                                <td class="text-end" t-esc="'%.2f' % doc.qty_on_hand"/>
                                <td class="text-end" t-esc="'%.2f' % doc.product_min_qty"/>
                                <td class="text-end" t-esc="'%.2f' % doc.product_max_qty"/>
                                <td class="text-end">
                                    <strong t-if="doc.qty_to_order"
                                            t-esc="'%.2f' % doc.qty_to_order"/>
                                </td>
                                <td t-esc="doc.supplier_id.name if doc.supplier_id else '—'"/>
                                <td class="text-end" t-esc="doc.lead_days or '—'"/>
                                <td t-esc="doc.estimated_arrival or '—'"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

            </div>
        </t>
    </template>

    <template id="report_stock_alerts">
        <t t-call="web.html_container">
            <t t-call="lv_nova_stock_alerts.report_stock_alerts_document"/>
        </t>
    </template>

</odoo>
