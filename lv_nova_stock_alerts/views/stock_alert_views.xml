<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         1. Kanban — the visual dashboard card per orderpoint
         ================================================================ -->
    <record id="view_stock_alert_kanban" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.alert.kanban</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="alert_level"
                    class="o_kanban_small_column"
                    records_draggable="false"
                    group_create="false">

                <field name="product_id"/>
                <field name="qty_on_hand"/>
                <field name="product_min_qty"/>
                <field name="product_max_qty"/>
                <field name="qty_to_order"/>
                <field name="alert_level"/>
                <field name="supplier_id"/>
                <field name="lead_days"/>
                <field name="estimated_arrival"/>
                <field name="product_uom"/>

                <templates>
                    <t t-name="kanban-card">
                        <!-- Card border colour driven by alert level -->
                        <t t-set="border_color"
                            t-value="record.alert_level.raw_value == 'critical' and '#dc3545'
                                     or record.alert_level.raw_value == 'warning' and '#ffc107'
                                     or '#198754'"/>
                        <div t-attf-style="border-left:4px solid #{border_color}; padding:10px 12px;">

                            <!-- Product name + badge -->
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <strong class="o_kanban_record_title"
                                        style="font-size:13px; line-height:1.3;">
                                    <field name="product_id"/>
                                </strong>
                                <t t-if="record.alert_level.raw_value == 'critical'">
                                    <span class="badge text-bg-danger ms-1">OUT</span>
                                </t>
                                <t t-elif="record.alert_level.raw_value == 'warning'">
                                    <span class="badge text-bg-warning ms-1">LOW</span>
                                </t>
                            </div>

                            <!-- Stock quantities row -->
                            <div class="d-flex gap-3 my-2" style="font-size:12px;">
                                <div>
                                    <span class="text-muted">On hand</span><br/>
                                    <strong t-attf-style="color:#{border_color}">
                                        <field name="qty_on_hand"/>
                                        <field name="product_uom"/>
                                    </strong>
                                </div>
                                <div>
                                    <span class="text-muted">Min</span><br/>
                                    <field name="product_min_qty"/>
                                </div>
                                <div t-if="record.qty_to_order.raw_value > 0">
                                    <span class="text-muted">To order</span><br/>
                                    <strong><field name="qty_to_order"/></strong>
                                </div>
                            </div>

                            <!-- Mini progress bar: on_hand / min -->
                            <t t-set="pct"
                               t-value="record.product_min_qty.raw_value and
                                        min(100, int(record.qty_on_hand.raw_value /
                                        record.product_min_qty.raw_value * 100)) or 0"/>
                            <div style="background:#e9ecef; border-radius:4px; height:6px; margin-bottom:8px;">
                                <div t-attf-style="width:#{pct}%; height:6px; border-radius:4px; background:#{border_color};"/>
                            </div>

                            <!-- Supplier info -->
                            <div style="font-size:11px; color:#6c757d;" class="mb-2">
                                <t t-if="record.supplier_id.raw_value">
                                    <i class="fa fa-truck me-1"/>
                                    <field name="supplier_id"/>
                                    <t t-if="record.lead_days.raw_value">
                                        · <field name="lead_days"/> days
                                    </t>
                                    <t t-if="record.estimated_arrival.raw_value">
                                        · ETA <field name="estimated_arrival"/>
                                    </t>
                                </t>
                                <t t-else="">
                                    <span class="text-warning">
                                        <i class="fa fa-exclamation-triangle me-1"/>No supplier
                                    </span>
                                </t>
                            </div>

                            <!-- Quick PO button -->
                            <t t-if="record.qty_to_order.raw_value > 0 and record.supplier_id.raw_value">
                                <button name="action_create_po_single"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary w-100">
                                    <i class="fa fa-shopping-cart me-1"/> Create PO
                                </button>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         2. List view — secondary, good for bulk selection + wizard
         ================================================================ -->
    <record id="view_stock_alert_list" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.alert.list</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <list decoration-danger="alert_level == 'critical'"
                  decoration-warning="alert_level == 'warning'"
                  decoration-muted="alert_level == 'ok'">
                <field name="alert_level" widget="badge"
                       decoration-danger="alert_level == 'critical'"
                       decoration-warning="alert_level == 'warning'"
                       decoration-success="alert_level == 'ok'"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="qty_on_hand"/>
                <field name="product_min_qty" string="Minimum"/>
                <field name="product_max_qty" string="Maximum"/>
                <field name="qty_to_order"/>
                <field name="supplier_id"/>
                <field name="lead_days" string="Lead (days)"/>
                <field name="estimated_arrival" optional="show"/>
                <field name="supplier_price" optional="hide"/>
                <field name="last_alert_sent" optional="hide"/>
                <button name="action_create_po_single"
                        type="object"
                        icon="fa-shopping-cart"
                        string="Create PO"
                        invisible="qty_to_order == 0 or not supplier_id"
                        title="Create purchase order for this product"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         3. Search view
         ================================================================ -->
    <record id="view_stock_alert_search" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.alert.search</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="location_id"/>
                <separator/>
                <filter string="Out of Stock" name="critical"
                        domain="[('alert_level','=','critical')]"/>
                <filter string="Low Stock" name="warning"
                        domain="[('alert_level','=','warning')]"/>
                <filter string="Needs Attention" name="needs_attention"
                        domain="[('alert_level','in',('critical','warning'))]"/>
                <filter string="No Supplier" name="no_supplier"
                        domain="[('supplier_id','=',False)]"/>
                <separator/>
                <filter string="Active Rules" name="active"
                        domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Alert Level" name="by_alert"
                            context="{'group_by':'alert_level'}"/>
                    <filter string="Supplier" name="by_supplier"
                            context="{'group_by':'supplier_id'}"/>
                    <filter string="Warehouse" name="by_warehouse"
                            context="{'group_by':'warehouse_id'}"/>
                    <filter string="Location" name="by_location"
                            context="{'group_by':'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         4. Actions
         ================================================================ -->
    <record id="action_stock_alert_dashboard" model="ir.actions.act_window">
        <field name="name">Stock Alerts</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_needs_attention': 1}</field>
        <field name="domain">[('active','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                No reorder rules configured yet, or all products are
                above their minimum stock level. 🎉
            </p>
            <p>
                Configure reorder rules under
                <strong>Inventory → Configuration → Reorder Rules</strong>
                to start monitoring stock levels here.
            </p>
        </field>
    </record>

    <!-- Bind bulk-wizard to the list action menu -->
    <record id="action_stock_alert_create_po_from_list" model="ir.actions.act_window">
        <field name="name">Create Purchase Orders</field>
        <field name="res_model">stock.alert.create.po.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_orderpoint_ids': active_ids}</field>
    </record>

    <!-- ================================================================
         5. Menus
         ================================================================ -->
    <menuitem id="menu_stock_alert_dashboard"
              name="Stock Alerts"
              parent="stock.menu_stock_root"
              action="action_stock_alert_dashboard"
              sequence="3"/>

</odoo>
