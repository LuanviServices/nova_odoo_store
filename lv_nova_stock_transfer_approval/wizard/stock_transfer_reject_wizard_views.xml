<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_transfer_reject_wizard_form" model="ir.ui.view">
        <field name="name">stock.transfer.reject.wizard.form</field>
        <field name="model">stock.transfer.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Transfer">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="reason"
                           placeholder="Explain why this transfer is being rejected…"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            type="object"
                            string="Confirm Rejection"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
