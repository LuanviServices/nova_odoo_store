<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ocultar paginas de (contactos y directciones), (ventas y compras) del contacto -->
    <record id="view_partner_form_inherit_wallet" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <page name="contact_addresses" position="replace"/>
            <page name="sales_purchases" position="replace"/>
        </field>
    </record>
    <!-- Ocultar campos innecesarios en lista de empleados -->
    <record id="view_partner_list_inherit_wallet" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="replace"/>
            <field name="company_id" position="replace"/>
        </field>
    </record>
    <!-- Ocultar pagina de facturacion del contacto -->
    <record id="view_partner_property_form_inherit_wallet" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <page name="accounting" position="replace"/>
        </field>
    </record>
    <!-- Ocultar boton inteligente Factura en los contactos y agg nuevos -->
    <record id="partner_view_buttons_inherit_wallet" model="ir.ui.view">
        <field name="name">res.partner.view.buttons.inherit.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.partner_view_buttons"/>
        <field name="arch" type="xml">
            <button name="action_view_partner_invoices" position="after">
                <!-- Todas las transacciones -->
                <button name="action_view_transactions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange">
                    <field name="transaction_count" widget="statinfo" string="Transactions"/>
                </button>
                <!-- Solo ingresos -->
                <button name="action_view_transactions_income"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-arrow-up text-success">
                    <field name="transaction_income_count" widget="statinfo" string="Incomes"/>
                </button>
                <!-- Solo gastos -->
                <button name="action_view_transactions_expense"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-arrow-down text-danger">
                    <field name="transaction_expense_count" widget="statinfo" string="Expenses"/>
                </button>
                <!-- Deudas -->
                <button name="action_view_debts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <field name="debts_count" widget="statinfo" string="Debts"/>
                </button>
            </button>
            <button name="action_view_partner_invoices" position="replace"/>
        </field>
    </record>
    <!-- Ocultar boton actividades en contactos Kanban -->
    <record id="res_partner_view_kanban_inherit_mail_wallet" model="ir.ui.view">
        <field name="name">res.partner.view.kanban.inherit.mail.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="mail.res_partner_view_kanban_inherit_mail"/>
        <field name="arch" type="xml">
            <field name="activity_ids" position="replace"/>
        </field>
    </record>
    <!-- Ocultar actividades en contactos Lista -->
    <record id="res_partner_view_list_inherit_mail_wallet" model="ir.ui.view">
        <field name="name">res.partner.view.list.inherit.mail.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="mail.res_partner_view_tree_inherit_mail"/>
        <field name="arch" type="xml">
            <field name="activity_ids" position="replace"/>
        </field>
    </record>
    <!-- Ocultar filtros u agrupadores innecesarios -->
    <record id="res_partner_view_filter_inherit_wallet" model="ir.ui.view">
        <field name="name">res.partner.view.filter.inherit.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="replace"/>
            <filter name="salesperson" position="replace"/>
            <filter name="group_company" position="replace"/>
        </field>
    </record>
    <!-- Ocultar filtros u agrupadores innecesarios contables -->
    <record id="res_partner_view_search_inherit_wallet" model="ir.ui.view">
        <field name="name">res.partner.view.search.inherit.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.res_partner_view_search"/>
        <field name="arch" type="xml">
            <filter name="customer" position="replace"/>
            <filter name="supplier" position="replace"/>
        </field>
    </record>
    <!-- Accion de contactos -->
    <record id="action_contacts_wallet" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a Contact in your address book
          </p><p>
            Nova helps you track all activities related to your contacts.
          </p>
        </field>
    </record>
</odoo>