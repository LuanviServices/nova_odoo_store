<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_wallet_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">wallet.budget.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new budgets for records
            </p>
            <p>
                Nova helps you manage budgets.
            </p>
        </field>
    </record>


    <!-- Budget Tags -->
    <record id="action_wallet_budget_tag" model="ir.actions.act_window">
        <field name="name">Budget Tags</field>
        <field name="res_model">wallet.budget.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new budget tag
            </p>
            <p>
                Budget tags help you categorize your budgets.
            </p>
        </field>
    </record>


    <!-- Budget Tags Tree -->
    <record id="wallet_budget_tag_list_view" model="ir.ui.view">
        <field name="name">wallet.budget.tag.list.view</field>
        <field name="model">wallet.budget.tag</field>
        <field name="arch" type="xml">
            <list string="Budget Tags">
                <field name="name"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>


    <!-- Budget Tags Form -->
    <record id="wallet_budget_tag_form_view" model="ir.ui.view">
        <field name="name">wallet.budget.tag.form.view</field>
        <field name="model">wallet.budget.tag</field>
        <field name="arch" type="xml">
            <form string="Budget Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker" string="Color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="wallet_budget_plan_form_view" model="ir.ui.view">
        <field name="name">wallet_budget_plan_form_view</field>
        <field name="model">wallet.budget.plan</field>
        <field name="arch" type="xml">
            <form string="Budget Planning">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Budget 2025 ......"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="start_date" string="Validity"/>
                            <div class="o_row">
                                <field name="start_date" required="1" widget="daterange" readonly="state != 'draft'" options="{'end_date_field': 'end_date'}" />
                            </div>
                            <field name="ref"/>
                            <field name="tag_ids" widget="many2many_tags" />
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="color" widget="color_picker" string="Color" />
                            <field name="state" readonly="1" invisible="1"/>
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Budget Lines">
                            <field name="line_ids">
                                <list string="Budget Lines" editable="bottom">
                                    <field name="category_id"/>
                                    <field name="assigned_amount" widget="monetary"/>
                                    <field name="committed_amount" widget="monetary"/>
                                    <field name="executed_amount" widget="monetary"/>
                                    <field name="available_amount" widget="monetary"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>

                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>