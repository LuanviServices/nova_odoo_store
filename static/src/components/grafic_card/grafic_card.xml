<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="lv_personal_wallet.GraficCard" owl="1">
        <div class="shadow-sm border m-2 p-4 bg-white text-center">
            <!-- Valor con color dinámico -->
            <div t-if="props.dynamic_color"
                t-attf-class="h1 fw-bold #{toFloat(props.value) >= 0 ? 'text-success' : 'text-danger'}"
                style="font-size: 4vw; max-width: 100%; word-wrap: break-word;">
                <span t-esc="props.value"/>
            </div>
            <!-- Valor con color fijo -->
            <div t-if="!props.dynamic_color"
                    t-attf-class="h1 fw-bold text-{{ props.color }}"
                    style="font-size: 4vw; max-width: 100%; word-wrap: break-word;">
                <span t-esc="props.value"/>
            </div>
            <!-- Etiqueta -->
            <div class="h3 text-muted text-truncate">
                <span t-esc="props.name"/>
            </div>
        </div>
    </t>
</templates>
