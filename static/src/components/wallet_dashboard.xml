<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="lv_personal_wallet.LvNovaWalletDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="container-fluid py-3">
                <!-- Encabezado -->
                <div class="text-center mb-3 px-2">
                    <h1 class="text-primary fw-bold">Summary</h1>
                    <div class="d-flex justify-content-end gap-2">
                        <!-- Selector de mes -->
                        <select class="form-select w-auto" style="max-width: 250px;" t-model="state.selectedMonth" t-on-change="updatePeriod">
                            <option t-att-value="1">January</option>
                            <option t-att-value="2">February</option>
                            <option t-att-value="3">March</option>
                            <option t-att-value="4">April</option>
                            <option t-att-value="5">May</option>
                            <option t-att-value="6">June</option>
                            <option t-att-value="7">July</option>
                            <option t-att-value="8">August</option>
                            <option t-att-value="9">September</option>
                            <option t-att-value="10">October</option>
                            <option t-att-value="11">November</option>
                            <option t-att-value="12">December</option>
                        </select>
                        <!-- Selector de año -->
                        <select class="form-select w-auto" style="max-width: 250px;" t-model="state.selectedYear" t-on-change="updatePeriod">
                            <t t-foreach="state.availableYears" t-as="year" t-key="year">
                                <option t-att-value="year"><t t-esc="year" /></option>
                            </t>
                        </select>
                    </div>
                </div>
                <!-- Counters -->
                <div class="row g-3 mt-3 px-2">
                    <div class="col-6 col-sm-6 col-md-3">
                        <GraficCard name="state.txt_1" value="state.summary.transactions" color="'primary'"/>
                    </div>
                    <div class="col-6 col-sm-6 col-md-3">
                        <GraficCard name="state.txt_3" value="state.summary.revenue" color="'success'"/>
                    </div>
                    <div class="col-6 col-sm-6 col-md-3">
                        <GraficCard name="state.txt_2" value="state.summary.expenses" color="'danger'"/>
                    </div>
                    <div class="col-6 col-sm-6 col-md-3">
                        <GraficCard name="state.txt_4" value="state.summary.accounts" dynamic_color="true"/>
                    </div>
                </div>
                <!-- INGRESOS -->
                <div class="row mt-4 mb-2">
                    <div class="col-12">
                        <div class="border-top border-secondary position-relative">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted fw-bold fs-6 fs-md-4">
                                Incomes
                            </span>
                        </div>
                    </div>
                </div>
                <!-- Gráficos secundarios -->
                <div class="row g-3 mt-3 px-2">
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Top Incomes</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'doughnut'" title="state.txt_5" data="state.topIncomes"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Top Accounts</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'pie'" title="state.txt_6" data="state.topIncomnesAccounts"/>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Gráficos principales -->
                <div class="row g-3 mt-3 px-2">
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Main Transactions</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'line'" title="state.txt_7" data="state.topIncomesTransactions"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Debts to receive</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'bar'" title="state.txt_8" data="state.topReceives"/>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- GASTOS -->
                <div class="row mt-4 mb-2">
                    <div class="col-12">
                        <div class="border-top border-secondary position-relative">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted fw-bold fs-6 fs-md-4">
                                Expenses
                            </span>
                        </div>
                    </div>
                </div>
                <!-- Gráficos secundarios -->
                <div class="row g-3 mt-3 px-2">
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Top Expenses</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'doughnut'" title="state.txt_9" data="state.topExpenses"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Top Accounts</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'pie'" title="state.txt_6" data="state.topExpensesAccounts"/>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Gráficos principales -->
                <div class="row g-3 mt-3 px-2">
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Main Transactions</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'line'" title="state.txt_7" data="state.topExpensesTransactions"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm border h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="text-primary fw-bold mb-0">Debts to pay</h3>
                                    <div class="bg-primary rounded p-2 cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRender type="'bar'" title="state.txt_8" data="state.topPays"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Spacer para evitar que el gráfico se corte al final -->
            <div style="height: 100px; visibility: hidden;"></div>
        </div>
    </t>
</templates>
