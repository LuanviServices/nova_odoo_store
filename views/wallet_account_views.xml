<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- CUENTAS FORMULARIO -->
    <record id="view_settings_wallet_account_form" model="ir.ui.view">
        <field name="name">settings.wallet.account.form</field>
        <field name="model">wallet.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="is_propietary" invisible="1"/>
                    <field name="can_transact" invisible="1"/>
                    <field name="image" widget="image" class="oe_avatar" readonly="is_propietary == False"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h3>
                            <field name="name" class="oe_inline" placeholder="Account Name ..." readonly="is_propietary == False"/>
                        </h3>
                    </div>
                    <div class="alert alert-info" invisible="is_propietary == True" style="margin-bottom: 15px;">
                        <h5 style="margin-bottom: 5px;">
                            <i class="fa fa-share-alt"></i> Shared account
                        </h5>
                        <p style="margin: 0 0 5px 0;">
                            This account was shared with you by: 
                            <strong><field name="create_uid"/></strong>
                        </p>
                        <p style="margin: 0;">
                            <strong>Permissions: </strong>
                        </p>
                        <span invisible="can_transact == True">Only view</span>
                        <span invisible="can_transact == False">Can transact</span>
                    </div>
                    <notebook>
                        <page name="wallet_account_info_page" string="Information">
                            <group>
                                <group>
                                    <field name="account_type" widget="radio" readonly="is_propietary == False"/>
                                </group>
                                <group>
                                    <field name="color" widget="color_picker" string="Color" readonly="is_propietary == False"/>
                                    <field name="account_tag" string="Tag"/>
                                    <field name="show_panel" readonly="is_propietary == False" widget="boolean_toggle"/>
                                    <field name="bank_id" options="{'no_open': True, 'no_create': True}" readonly="is_propietary == False"/>
                                    <field name="bank_number" readonly="is_propietary == False"/>
                                    <field name="card_number" readonly="is_propietary == False"/>
                                    <field name="cutoff_day" invisible="account_type != 'credit_card'" readonly="is_propietary == False"/>
                                    <field name="amount_allocated" invisible="account_type != 'credit_card'" readonly="is_propietary == False"/>
                                    <field name="amount_available" invisible="account_type != 'credit_card'" readonly="is_propietary == False"/>
                                </group>
                            </group>
                        </page>
                        <page string="Shared Users" invisible="is_propietary == False">
                            <field name="permissions_ids">
                                <list editable="bottom">
                                    <field name="user_id" domain="[('id','in',parent.share_available_users)]"/>
                                    <field name="permission_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- CUENTAS LISTADO -->
    <record id="view_settings_wallet_account_tree" model="ir.ui.view">
        <field name="name">settings.wallet.account.tree</field>
        <field name="model">wallet.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_type"/>
                <field name="account_tag"/>
                <field name="active" widget="boolean_toggle" readonly="is_propietary == False"/>
            </list>
        </field>
    </record>

    <!-- VISTA DE BUSQUEDA-->
    <record id="view_settings_wallet_account_search" model="ir.ui.view">
        <field name="name">view.settings.wallet.account.search</field>
        <field name="model">wallet.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_type"/>
                <field name="card_number"/>
                <field name="bank_number"/>
                <separator/>
                <filter string="My Accounts" name="my_accounts" domain="[('create_uid', '=', uid)]"/>
                <filter string="Shareds" name="my_shareds" domain="[('create_uid', '!=', uid)]"/>
                <separator/>
                <filter name="account_type_group" string="Account Type" context="{'group_by': 'account_type'}" />
                <filter name="account_type_bank" string="Bank" context="{'group_by': 'bank_id'}" />
            </search>
        </field>
    </record>

    <!-- ACCIÓN PARA LISTAR CUENTAS -->
    <record id="action_settings_wallet_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">wallet.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new account for records
            </p>
            <p>
                Nova helps you manage multiple accounts.
            </p>
        </field>
    </record>

</odoo>