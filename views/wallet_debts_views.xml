<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- DEUDAS FORMULARIO TODAS -->
    <record id="view_wallet_debts_all_form" model="ir.ui.view">
        <field name="name">wallet.debts.form</field>
        <field name="model">wallet.debts</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" icon="fa-file" invisible="state!='draft'" type="object" string="Confirm"/>
                    <button name="action_settle_debt" type="object" class="btn btn-primary" icon="fa-money" invisible="payment_status in ('liquidated','forgiven') or state == 'draft'or debt_type == 'receive'" string="Pay"/>
                    <button name="action_settle_debt" type="object" class="btn btn-primary" icon="fa-money" invisible="payment_status in ('liquidated','forgiven') or state == 'draft' or debt_type == 'pay'" string="Receive"/>
                    <button name="action_forgive_debt" type="object" class="btn btn-primary" icon="fa-handshake-o" invisible="payment_status in ('liquidated','forgiven') or state == 'draft'" string="Forgive"/>
                    <button name="action_postpone_debt" type="object" class="btn btn-primary" invisible="state == 'draft' or not is_overdue" icon="fa-clock-o" string="Postpone"/>
                    <button name="action_to_draft" type="object" invisible="state == 'draft'" string="Reset to draft"/>
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Liquidated" bg_color="text-bg-success" invisible="payment_status != 'liquidated'"/>
                    <widget name="web_ribbon" title="Forgiven" bg_color="text-bg-info" invisible="payment_status != 'forgiven'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_status" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <label for="partner_id" string="Partner" style="font-weight:bold;"/>
                            <div class="o_col">
                                <field name="partner_id" widget="res_partner_many2one" nolabel="1" context="{'show_address': 1, 'default_is_company': True, 'show_vat': True}" domain="[('company_id', 'in', (False, company_id))]" options='{"no_quick_create": True}'/>
                            </div>
                            <field name="debt_type" options="{'horizontal': True}" readonly="state != 'draft'" widget="radio"/>
                            <field name="wallet_account" force_save="1" readonly="state != 'draft'" options="{'no_open':True, 'no_create': True}"/>
                            <field name="description" placeholder="Debt Details ....."/>
                        </group>
                        <group>
                            <label for="start_date" string="Validity"/>
                            <div class="o_row">
                                <field name="start_date" required="1" widget="daterange" readonly="state != 'draft'" options="{'end_date_field': 'end_date'}" />
                            </div>
                            <field name="is_overdue" invisible="1"/>
                            <field name="end_date" string="Expiration" widget="remaining_days" readonly="1"/>
                            <field name="amount" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0" widget='monetary' force_save="1" readonly="state != 'draft'"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual" invisible = "amount_residual == 0"/>
                            <field name="payment_status" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="transactions" invisible="state == 'draft'" string="Transactions">
                            <field name="transaction_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

