    <!-- DEUDAS LISTADO TODAS -->
    <record id="view_wallet_debts_all_tree" model="ir.ui.view">
        <field name="name">wallet.debts.tree</field>
        <field name="model">wallet.debts</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="is_overdue" column_invisible="1"/>
                <field name="company_currency_id" invisible="1" optional="hide"/>
                <field name="name"/>
                <field name="debt_type"/>
                <field name="wallet_account" optional="hide"/>
                <field name="account_tag" string="Account" />
                <field name="partner_id"/>
                <field name="description" widget="section_and_note_text"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
                <field name="payment_status" widget="badge" decoration-danger="payment_status != 'forgiven'" decoration-success="payment_status != 'liquidated'"/>
                <field name="amount" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0"/>
            </list>
        </field>
    </record>

