                <filter name="partner_id" string="Creditor" context="{'group_by': 'partner_id'}" />
                <filter name="wallet_account" string="Account" context="{'group_by': 'wallet_account'}" />
                <filter name="start_date" string="Start Date" context="{'group_by': 'start_date'}" />
                <filter name="end_date" string="End Date" context="{'group_by': 'end_date'}" />
            </search>
        </field>
    </record>

    <!-- ACCIÓN PARA LISTAR DEUDAS TODAS -->
    <record id="action_wallet_debts_all" model="ir.actions.act_window">
        <field name="name">All debts</field>
        <field name="res_model">wallet.debts</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), 
                                  (0, 0, {'view_mode': 'list', 'view_id': ref('view_wallet_debts_all_tree')}),
                                  (0, 0, {'view_mode': 'form', 'view_id': ref('view_wallet_debts_all_form')})]"/>
        <field name="search_view_id" ref="view_wallet_debts_search"/>
        <field name="context">{'search_default_state_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new debts for records
            </p>
            <p>
                Nova helps you manage multiple debts.
            </p>
        </field>
    </record>

