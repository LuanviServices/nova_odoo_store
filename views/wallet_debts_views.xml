    <!-- FILTROS Y AGRUPADORES DEUDAS -->
    <record id="view_wallet_debts_search" model="ir.ui.view">
        <field name="name">view.wallet.debts.search</field>
        <field name="model">wallet.debts</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="wallet_account"/>
                <field name="amount"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="debt_type"/>
                <!-- Filtros-->
                <filter name="state_active" string="Active" domain="[('state', '=', 'active')]" />
                <filter name="type_pay" string="Pay" domain="[('debt_type', '=', 'pay')]" />
                <filter name="type_receive" string="Receive" domain="[('debt_type', '=', 'receive')]" />
                <!-- Agrupadores-->
                <filter name="state" string="State" context="{'group_by': 'state'}" />
                <filter name="payment_status" string="Payment Status" context="{'group_by': 'payment_status'}" />
                <filter name="partner_id" string="Creditor" context="{'group_by': 'partner_id'}" />
                <filter name="debt_type" string="Type" context="{'group_by': 'debt_type'}" />
                <filter name="wallet_account" string="Account" context="{'group_by': 'wallet_account'}" />
                <filter name="start_date" string="Start Date" context="{'group_by': 'start_date'}" />
                <filter name="end_date" string="End Date" context="{'group_by': 'end_date'}" />
            </search>
        </field>
    </record>

