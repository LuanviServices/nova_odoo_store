    <!-- TRANSACCIONES LISTADO -->
    <record id="view_wallet_transaction_tree" model="ir.ui.view">
        <field name="name">wallet.transaction.tree</field>
        <field name="model">wallet.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_currency_id" invisible="1" optional="hide"/>
                <field name="name"/>
                <field name="transaction_type"/>
                <field name="category"/>
                <field name="wallet_account" optional="hide" />
                <field name="account_tag" string="Account" />
                <field name="beneficiary_id"/>
                <field name="description"/>
                <field name="date"/>
                <field name="amount" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0"/>
                <field name="amount_tax" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0"/>
                <field name="amount_total" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0"/>
            </list>
        </field>
    </record>

