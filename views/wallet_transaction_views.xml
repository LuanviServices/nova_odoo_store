    <!-- TRANSACCIONES LISTADO IMPUESTOS -->
    <record id="view_wallet_transaction_tax_tree" model="ir.ui.view">
        <field name="name">wallet.transaction.tax.tree</field>
        <field name="model">wallet.transaction.tax</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="tax_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="beneficiary_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

</odoo>