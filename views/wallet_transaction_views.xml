                <filter name="category" string="Category" context="{'group_by': 'category'}" />
                <filter name="tag" string="Tag" context="{'group_by': 'tag'}" />
                <filter name="date" string="Date" context="{'group_by': 'date'}" />
            </search>
        </field>
    </record>

    <!-- ACCIÓN PARA LISTAR TRANSACCIONES -->
    <record id="action_wallet_transaction_all" model="ir.actions.act_window">
        <field name="name">All transaction</field>
        <field name="res_model">wallet.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_wallet_transaction_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_wallet_transaction_form')})]"/>
        <field name="search_view_id" ref="view_wallet_transaction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transaction for records
            </p>
            <p>
                Nova helps you manage multiple transactions.
            </p>
        </field>
    </record>

