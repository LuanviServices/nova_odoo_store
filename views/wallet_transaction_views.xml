                <separator/>
                <!-- Filtros-->
                <filter name="is_transfer" string="Tranfers" domain="[('transfer', '=', True)]" />
                <filter name="with_taxes" string="With taxes" domain="[('tax_ids', '!=', False)]" />
                <filter name="without_taxes" string="Without taxes" domain="[('tax_ids', '=', False)]" />
                <!-- Agrupadores-->
