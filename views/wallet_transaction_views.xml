    <!-- FILTROS Y AGRUPADORES TRANSACCIONES -->
    <record id="view_wallet_transaction_search" model="ir.ui.view">
        <field name="name">view.wallet.transaction.search</field>
        <field name="model">wallet.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="beneficiary_id"/>
                <field name="wallet_account"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="transaction_type"/>
                <field name="tag"/>
                <field name="category"/>
                <!-- Filtros-->
                <separator/>
                <filter name="type_expense" string="Expenses" domain="[('transaction_type', '=', 'expense')]" />
                <filter name="type_income" string="Incomes" domain="[('transaction_type', '=', 'income')]" />
                <separator/>
                <filter name="is_transfer" string="Tranfers" domain="[('transfer', '=', True)]" />
                <filter name="with_taxes" string="With taxes" domain="[('tax_ids', '!=', False)]" />
                <filter name="without_taxes" string="Without taxes" domain="[('tax_ids', '=', False)]" />
                <!-- Agrupadores-->
                <separator/>
                <filter name="beneficiary_id" string="Beneficiary" context="{'group_by': 'beneficiary_id'}" />
                <filter name="transaction_type" string="Type" context="{'group_by': 'transaction_type'}" />
                <filter name="wallet_account" string="Account" context="{'group_by': 'wallet_account'}" />
                <filter name="category" string="Category" context="{'group_by': 'category'}" />
                <filter name="tag" string="Tag" context="{'group_by': 'tag'}" />
                <filter name="date" string="Date" context="{'group_by': 'date'}" />
            </search>
        </field>
    </record>

    <!-- FILTROS Y AGRUPADORES TRANSACCIONES INGRESOS Y EGRESOS -->
