<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- TRANSACCIONES FORMULARIO TODAS -->
    <record id="view_wallet_transaction_form" model="ir.ui.view">
        <field name="name">wallet.transaction.form</field>
        <field name="model">wallet.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <field name="tag" widget="many2many_tags"/>
                        <field name="template_id"/>
                        <field name="shared_record" invisible="1"/>
                        <page name="page_transaction" string="Transaction">
                            <group>
                                <group colspan="2">
                                    <field name="description" placeholder="Enter a brief and clear description of your transaction ..." readonly="shared_record not in ('propietary','transaction')"/>
                                </group>
                                <group name="wallet_transaction_left">
                                    <field name="date" readonly="shared_record not in ('propietary','transaction')"/>
                                    <field name="beneficiary_id" options="{'no_create': True, 'no_create_edit': True}" readonly="shared_record not in ('propietary','transaction')"/>
                                    <field name="category" required="1" options="{'no_create': True, 'no_create_edit': True}" readonly="shared_record not in ('propietary','transaction')"/>
                                    <field name="payment_method" required="1" readonly="shared_record not in ('propietary','transaction')"/>
                                    <field name="tag" placeholder="Tags ...." widget="many2many_tags" options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}" readonly="shared_record not in ('propietary','transaction')"/>
                                </group>
                                <group name="wallet_transaction_right">
                                    <field name="wallet_account" options="{'no_create': True, 'no_create_edit': True}" readonly="shared_record not in ('propietary')"/>
                                    <field name="transaction_type" widget="radio" readonly="shared_record not in ('propietary','transaction')"/>
                                    <field name="amount" readonly="shared_record not in ('propietary','transaction')"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total"/>
                                </group>
                            </group>
                        </page>
                        <page name="taxes" string="Taxes">
                            <field name="tax_ids" readonly="shared_record not in ('propietary','transaction')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

