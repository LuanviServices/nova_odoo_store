<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- VISTA KANBAN -->
        <record id="view_wallet_account_kanban" model="ir.ui.view">
            <field name="name">wallet.account.kanban</field>
            <field name="model">wallet.account</field>
            <field name="arch" type="xml">
                <kanban create="false">
                    <field name="color"/>
                    <field name="amount"/>
                    <field name="account_type"/>
                    <field name="next_cutoff_date"/>
                    <field name="cutoff_day_color"/>
                    <field name="amount_allocated"/>
                    <field name="amount_available"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <aside class="o_kanban_aside_full">
                                <div class="o_kanban_image_fill position-relative w-100">
                                    <field name="image" alt="Account image" class="h-100" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                                </div>
                            </aside>
                            <main class="ps-2 ps-md-0">
                                <div class="position-absolute top-0 end-0 m-1">
                                    <t t-if="record.account_type.raw_value == 'general'">
                                        <i class="fa fa-briefcase text-warning" title="Wallet"></i>
                                    </t>
                                    <t t-if="record.account_type.raw_value == 'cash'">
                                        <i class="fa fa-money text-success" title="Cash"></i>
                                    </t>
                                    <t t-if="record.account_type.raw_value == 'bank'">
                                        <i class="fa fa-university text-primary" title="Bank"></i>
                                    </t>
                                    <t t-if="record.account_type.raw_value == 'credit_card'">
                                        <i class="fa fa-credit-card text-danger" title="Credit card"></i>
                                    </t>
                                    <t t-if="record.account_type.raw_value == 'savings'">
                                        <i class="fa fa-save text-warning" title="Savings"></i>
                                    </t>
                                    <t t-if="record.account_type.raw_value == 'investments'">
                                        <i class="fa fa-line-chart text-info" title="Investments"></i>
                                    </t>
                                </div>
                                <div style="margin-bottom: 12px;">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div>
                                    <t t-if="record.bank_number.raw_value">
                                        <p style="margin: 0;">
                                            <strong>Bank: </strong>
                                            <span>
                                                <field name="bank_number"/>
                                            </span>
                                        </p>
                                    </t>
                                    <t t-if="record.card_number.raw_value">
                                        <p style="margin: 0;">
                                            <strong>Card: </strong>
                                            <span>
                                                <field name="card_number"/>
                                            </span>
                                        </p>
                                    </t>
                                    <t t-if="record.next_cutoff_date.raw_value">
                                        <p style="margin: 0;">
                                            <strong>Cut-off Date: </strong>
                                            <span t-att-class="{
                                                    'text-primary': record.cutoff_day_color.raw_value == '1',
                                                    'text-warning': record.cutoff_day_color.raw_value == '2',
                                                    'text-danger': record.cutoff_day_color.raw_value == '3'
                                                }">
                                                <t t-esc="record.next_cutoff_date.value"/>
                                            </span>
                                        </p>
                                    </t>
                                </div>
                                <div>
                                    <t t-if="record.amount_allocated.raw_value">
                                        <p style="margin: 0;">
                                            <strong>Amount allocated: </strong>
                                            <span>
                                                <t t-esc="record.amount_allocated.value"/>
                                            </span>
                                        </p>
                                        <p style="margin: 0;">
                                            <strong>Amount available: </strong>
                                            <span>
                                                <t t-esc="record.amount_available.value"/>
                                            </span>
                                        </p>
                                    </t>
                                    <p style="margin: 0;">
                                        <strong>Amount: </strong>
                                        <span t-att-class="record.amount.raw_value >= 0 ? 'text-success' : 'text-danger'">
                                            <t t-esc="record.amount.value"/>
                                        </span>
                                    </p>
                                </div>
                                <footer class="mt-2">
                                    <button type="object"
                                        name="action_open_form"
                                        class="btn btn-outline-primary btn-sm"
                                        title="Open record">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                    <button type="object"
                                        name="action_view_transactions_all"
                                        class="btn btn-outline-secondary btn-sm"
                                        title="View transactions">
                                        <i class="fa fa-exchange"></i>
                                    </button>
                                    <button type="object"
                                        name="action_view_transactions_income"
                                        class="btn btn-outline-secondary btn-sm"
                                        title="View incomes">
                                        <i class="fa fa-arrow-up text-success"></i>
                                    </button>
                                    <button type="object"
                                        name="action_view_transactions_expense"
                                        class="btn btn-outline-secondary btn-sm"
                                        title="View expenses">
                                        <i class="fa fa-arrow-down text-danger"></i>
                                    </button>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ACCIÓN PARA LISTAR CUENTAS -->
        <record id="action_wallet_account" model="ir.actions.act_window">
            <field name="name">Accounts</field>
            <field name="res_model">wallet.account</field>
            <field name="view_mode">kanban</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new account for records
                </p>
                <p>
                    Nova helps you manage multiple accounts.
                </p>
            </field>
        </record>

        <!-- TRANSFERENCIAS FORMULARIO -->
        <record id="view_wallet_transfer_form" model="ir.ui.view">
            <field name="name">wallet.transfer.form</field>
            <field name="model">wallet.transfer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="description"/>
                                <field name="origin_account" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="destiny_account" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="tag" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>

                                <field name="date"/>
                                <field name="amount"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="transacttions" string="Transactions">
                                <field name="transaction_ids">
                                    <list>
                                        <field name="company_currency_id" invisible="1" optional="hide"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="account_tag" string="Account"/>
                                        <field name="description"/>
                                        <field name="amount" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0" />
                                        <field name="amount_tax" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0"/>
                                        <field name="amount_total" sum="Total" decoration-danger= "amount &lt; 0" decoration-success= "amount > 0"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TRANSFERENCIAS LISTADO -->
        <record id="view_wallet_transfer_list" model="ir.ui.view">
            <field name="name">wallet.transfer.list</field>
            <field name="model">wallet.transfer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="origin_account"/>
                    <field name="destiny_account"/>
                    <field name="description"/>
                    <field name="date"/>
                    <field name="amount"/>
                </list>
            </field>
        </record>

        <!-- TRANSFERENCIAS FILTROS Y AGRUPADORES -->
        <record id="view_wallet_transfer_search" model="ir.ui.view">
            <field name="name">view.wallet.transfer.search</field>
            <field name="model">wallet.transfer</field>
            <field name="arch" type="xml">
                <search>
                    <field name="description"/>
                    <field name="origin_account"/>
                    <field name="destiny_account"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="tag"/>
                    <!-- Agrupadores-->
                    <separator/>
                    <filter name="origin_account" string="Origin Account" context="{'group_by': 'origin_account'}" />
                    <filter name="destiny_account" string="Destiny Account" context="{'group_by': 'destiny_account'}" />
                    <filter name="tag" string="Tag" context="{'group_by': 'tag'}" />
                    <filter name="date" string="Date" context="{'group_by': 'date'}" />
                </search>
            </field>
        </record>

        <!-- ACCIÓN PARA LISTAR TRANSFERENCIAS -->
        <record id="action_wallet_transfer" model="ir.actions.act_window">
            <field name="name">Transfer</field>
            <field name="res_model">wallet.transfer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new transfer for records
                </p>
                <p>
                    Nova helps you manage multiple transfers.
                </p>
            </field>
        </record>

    </data>
</odoo>